# Copy to .env. Only JWT_SECRET is required to start the app.
JWT_SECRET=change-me
PORT=3000

# MySQL, e.g. mysql://user:pass@localhost:3306/mantra  (then run: pnpm db:push)
DATABASE_URL=

# Manus OAuth sign-in
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# AI providers (optional)
ANTHROPIC_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional external services (embedded fallbacks are used when empty)
OPENCLAW_URL=http://localhost:18789
OPENCLAW_TOKEN=
NEUROLINKED_URL=
