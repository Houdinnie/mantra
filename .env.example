# Copy to .env. Only JWT_SECRET is required to start the app.
JWT_SECRET=change-me
PORT=3000

# MySQL, e.g. mysql://user:pass@localhost:3306/mantra  (then run: pnpm db:push)
DATABASE_URL=

# Local sign-in without any OAuth server (single owner account, local use only).
# Set both, leave the Manus OAuth variables below empty.
AUTH_MODE=
VITE_AUTH_MODE=
OWNER_NAME=

# Manus OAuth sign-in
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Free-tier AI provider (optional): LLM_PROVIDER=gemini | groq | openrouter | custom
# Needs a free API key from the provider. LLM_MODEL is required for openrouter and custom.
# LLM_BASE_URL is only needed for custom (any OpenAI-compatible endpoint).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# AI providers (optional)
ANTHROPIC_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional external services (embedded fallbacks are used when empty)
OPENCLAW_URL=http://localhost:18789
OPENCLAW_TOKEN=
NEUROLINKED_URL=
